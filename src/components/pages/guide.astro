---
import { getCollection } from "astro:content";
import type { Locale } from "~/i18n";
import BaseLayout from "~/layouts/BaseLayout.astro";
import PageContent from "~/components/PageContent.astro";
import { getAlternateCollectionSlug } from "~/lib/page-registry";

interface Props {
  lang: Locale;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;

const allPages = await getCollection("pages");
const entry = allPages.find(
  (p) => p.id.startsWith(`${lang}/`) && p.data.translationKey === "guide",
);

if (!entry) {
  return Astro.redirect("/404");
}

const alternateSlug = await getAlternateCollectionSlug(lang, "pages", "guide");
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  lang={lang}
  currentSlug={currentSlug}
  alternateSlug={alternateSlug}
>
  <PageContent entry={entry} lang={lang} />
</BaseLayout>
