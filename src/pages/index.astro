---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Button from "~/components/Button.astro";
import FAQs from "~/components/FAQs.astro";
import { useTranslations, getLocalizedPath } from "~/i18n";
import { getFAQs } from "~/data/faqs";
import {
  ArrowRight,
  Terminal,
  MessagesSquare,
  Rocket,
  ExternalLink,
  Bell,
  Copy,
  Check,
} from "@lucide/astro";

const lang = "de" as const;
const { t } = useTranslations(lang);
const faqItems = getFAQs(lang);
const featuresHref = getLocalizedPath("funktionen", lang);
const repoUrl = "https://github.com/passion4it-gmbh/passionfruit";
const releasesUrl = `${repoUrl}/releases`;
const installCommand = t("home.ctaSection.command");
---

<BaseLayout
  title={t("site.name")}
  description={t("site.description")}
  lang={lang}
  headerVariant="on-dark"
>
  <!-- ═══════════ HERO ═══════════ -->
  <section
    class="relative min-h-dvh flex items-center overflow-hidden bg-surface-dark noise"
  >
    <div class="absolute inset-0">
      <div
        class="glow-orb absolute top-1/4 -left-32 w-[500px] h-[500px] rounded-full bg-accent/20 blur-[120px]"
      >
      </div>
      <div
        class="glow-orb absolute bottom-1/4 right-0 w-[400px] h-[400px] rounded-full bg-warm/15 blur-[100px]"
        style="animation-delay: 4s"
      >
      </div>
      <div class="absolute inset-0 bg-grid opacity-30"></div>
    </div>

    <div class="container relative z-10 py-24">
      <div class="max-w-3xl mx-auto text-center">
        <p class="eyebrow hero-stagger" style="--delay: 100ms">
          {t("site.name")}
        </p>

        <h1
          class="text-display text-text-on-dark mt-6 hero-stagger"
          style="--delay: 200ms"
        >
          {t("home.hero.headline")}
        </h1>

        <p
          class="text-body-lg text-text-on-dark/60 mt-6 mx-auto max-w-2xl hero-stagger"
          style="--delay: 400ms"
        >
          {t("home.hero.subheadline")}
        </p>

        <div class="hero-stagger mt-10" style="--delay: 600ms">
          <div
            class="inline-flex items-center gap-2 rounded-lg bg-white/5 ring-1 ring-white/10 px-5 py-3 font-mono text-sm text-text-on-dark/90"
          >
            <span class="text-accent-glow">$</span>
            <code id="hero-install-cmd">{installCommand}</code>
            <button
              type="button"
              data-copy-target="hero-install-cmd"
              aria-label={t("home.ctaSection.commandLabel")}
              class="ml-2 inline-flex items-center justify-center w-8 h-8 rounded-md text-text-on-dark/60 hover:text-text-on-dark hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <Copy class="copy-icon w-4 h-4" />
              <Check class="check-icon w-4 h-4 hidden text-accent-glow" />
            </button>
          </div>
        </div>

        <div
          class="flex flex-wrap gap-4 mt-8 justify-center hero-stagger"
          style="--delay: 750ms"
        >
          <Button
            href={featuresHref}
            variant="primary"
            tone="on-dark"
            class="btn-glow group"
          >
            {t("home.hero.ctaSecondary")}
            <ArrowRight
              class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
            />
          </Button>
          <Button href={repoUrl} variant="secondary" tone="on-dark">
            <ExternalLink class="w-4 h-4 mr-2" />
            GitHub
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ HOW IT WORKS ═══════════ -->
  <section class="relative py-28 md:py-40 bg-grid">
    <div class="container">
      <div class="max-w-2xl anim-slide-up">
        <p class="eyebrow">{t("home.howItWorks.eyebrow")}</p>
        <h2 class="text-h2 text-text-heading mt-4">
          {t("home.howItWorks.title")}
        </h2>
        <p class="text-body-lg text-muted mt-4">
          {t("home.howItWorks.subtitle")}
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mt-16">
        <div class="card anim-card-enter" style="--delay: 0ms">
          <div
            class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-6"
          >
            <Terminal class="w-6 h-6 text-accent" />
          </div>
          <p class="text-sm font-semibold text-accent">01</p>
          <h3 class="text-h3 text-text-heading mt-2">
            {t("home.howItWorks.step1.title")}
          </h3>
          <p class="text-muted mt-3 leading-relaxed">
            {t("home.howItWorks.step1.description")}
          </p>
        </div>

        <div class="card anim-card-enter" style="--delay: 100ms">
          <div
            class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-6"
          >
            <MessagesSquare class="w-6 h-6 text-accent" />
          </div>
          <p class="text-sm font-semibold text-accent">02</p>
          <h3 class="text-h3 text-text-heading mt-2">
            {t("home.howItWorks.step2.title")}
          </h3>
          <p class="text-muted mt-3 leading-relaxed">
            {t("home.howItWorks.step2.description")}
          </p>
        </div>

        <div class="card anim-card-enter" style="--delay: 200ms">
          <div
            class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center mb-6"
          >
            <Rocket class="w-6 h-6 text-accent" />
          </div>
          <p class="text-sm font-semibold text-accent">03</p>
          <h3 class="text-h3 text-text-heading mt-2">
            {t("home.howItWorks.step3.title")}
          </h3>
          <p class="text-muted mt-3 leading-relaxed">
            {t("home.howItWorks.step3.description")}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ FAQs ═══════════ -->
  <section class="py-28 md:py-40">
    <div class="container">
      <div class="text-center anim-slide-up">
        <h2 class="text-h2 text-text-heading">{t("home.faq.title")}</h2>
      </div>
      <div class="max-w-2xl mx-auto mt-16 anim-fade">
        <FAQs items={faqItems} />
      </div>
    </div>
  </section>

  <!-- ═══════════ CTA ═══════════ -->
  <section
    class="relative py-28 md:py-40 bg-surface-dark noise overflow-hidden"
  >
    <div class="absolute inset-0">
      <div
        class="glow-orb absolute top-1/2 left-1/4 w-[500px] h-[500px] rounded-full bg-accent/15 blur-[120px] -translate-y-1/2"
      >
      </div>
      <div
        class="glow-orb absolute top-1/2 right-1/4 w-[400px] h-[400px] rounded-full bg-warm/10 blur-[100px] -translate-y-1/2"
        style="animation-delay: 3s"
      >
      </div>
    </div>

    <div class="container relative z-10 text-center anim-scale-blur">
      <h2 class="text-h1 text-text-on-dark max-w-3xl mx-auto">
        {t("home.ctaSection.title")}
      </h2>
      <p class="text-body-lg text-text-on-dark/60 mt-6 max-w-xl mx-auto">
        {t("home.ctaSection.subtitle")}
      </p>

      <div class="mt-10 flex justify-center">
        <div
          class="inline-flex items-center gap-2 rounded-lg bg-white/5 ring-1 ring-white/10 px-5 py-3 font-mono text-sm text-text-on-dark/90"
        >
          <span class="text-accent-glow">$</span>
          <code id="cta-install-cmd">{installCommand}</code>
          <button
            type="button"
            data-copy-target="cta-install-cmd"
            aria-label={t("home.ctaSection.commandLabel")}
            class="ml-2 inline-flex items-center justify-center w-8 h-8 rounded-md text-text-on-dark/60 hover:text-text-on-dark hover:bg-white/10 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
          >
            <Copy class="copy-icon w-4 h-4" />
            <Check class="check-icon w-4 h-4 hidden text-accent-glow" />
          </button>
        </div>
      </div>

      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <Button href={repoUrl} variant="secondary" tone="on-dark">
          <ExternalLink class="w-4 h-4 mr-2" />
          {t("home.ctaSection.github")}
        </Button>
        <Button href={releasesUrl} variant="secondary" tone="on-dark">
          <Bell class="w-4 h-4 mr-2" />
          {t("home.ctaSection.releases")}
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initScrollAnimations() {
    if (CSS.supports("animation-timeline: scroll()")) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("in-view");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
    );

    document
      .querySelectorAll(
        ".anim-scale-blur, .anim-slide-up, .anim-slide-left, .anim-slide-right, .anim-fade, .anim-card-enter",
      )
      .forEach((el) => observer.observe(el));
  }

  function initCopyButtons() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-copy-target]")
      .forEach((btn) => {
        btn.addEventListener("click", async () => {
          const targetId = btn.dataset.copyTarget;
          if (!targetId) return;
          const target = document.getElementById(targetId);
          if (!target?.textContent) return;
          try {
            await navigator.clipboard.writeText(target.textContent.trim());
            const copyIcon = btn.querySelector(".copy-icon");
            const checkIcon = btn.querySelector(".check-icon");
            copyIcon?.classList.add("hidden");
            checkIcon?.classList.remove("hidden");
            setTimeout(() => {
              copyIcon?.classList.remove("hidden");
              checkIcon?.classList.add("hidden");
            }, 1800);
          } catch {
            // Clipboard API unavailable — gracefully no-op.
          }
        });
      });
  }

  initScrollAnimations();
  initCopyButtons();
  document.addEventListener("astro:after-swap", () => {
    initScrollAnimations();
    initCopyButtons();
  });
</script>
